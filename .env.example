NODE_ENV=development
PORT=1112
HOST=127.0.0.1

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10y
JWT_REFRESH_EXPIRES_IN=10y

CORS_ORIGIN=http://localhost:1111

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_ROUNDS=10

# ── Zoho Mail (invoice report sending) ─────────────────────────────
# Leave SMTP_USER/SMTP_PASS blank to disable sending. SMTP_PASS must be an
# app-specific password (Zoho account → Security → App Passwords), and the
# mailbox must be Zoho-hosted. For non-US data centers use the matching hosts
# (smtp.zoho.eu / imap.zoho.eu, etc.).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=KOSIGN
# Optional hidden archive copy of every sent email.
SMTP_BCC=
# Append a copy to the IMAP "Sent" folder. Keep false for Zoho — with IMAP
# enabled Zoho already auto-saves SMTP sends, so true would duplicate them.
SAVE_TO_SENT=false
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_SENT_FOLDER=Sent
