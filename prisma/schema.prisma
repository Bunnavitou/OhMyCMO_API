generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// ──────────────────────────── Tenancy / Auth ────────────────────────────

// Owners (role=ADMIN, ownerId=null) are tenant roots.
// Sub-users (role=USER, ownerId=<owner.id>) belong to that tenant.
// Owners log in by email; sub-users log in by username (globally unique).
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  password     String
  name         String?
  // Profile picture — a File-store reference ({ fileId, name, type, size }),
  // same shape as Product.logo. Self-editable from More > Profile.
  avatar       Json?
  role         Role     @default(USER)
  active       Boolean  @default(true)
  refreshToken String?

  ownerId      String?
  owner        User?    @relation("Tenancy", fields: [ownerId], references: [id], onDelete: Cascade)
  subUsers     User[]   @relation("Tenancy")

  permissions  Json?
  // Marks a sub-user as a designated PMO — managed via the PMO menu (list
  // from existing sub-users, no separate account creation). Distinct from
  // `role`, which is structural tenancy (owner vs sub-user), not job function.
  isPmo        Boolean  @default(false)

  // Who this sub-user reports to (their supervisor) — another sub-user, or
  // null meaning the tenant owner. Purely informational reporting-line data;
  // does not itself grant or restrict permissions.
  inChargeId   String?
  inCharge     User?    @relation("Supervision", fields: [inChargeId], references: [id], onDelete: SetNull)
  supervisees  User[]   @relation("Supervision")
  // Tasks this PMO manages (assigned to team members, e.g. Support staff) —
  // shape mirrors Customer.tasks. Independent of any single product, since a
  // PMO may own several.
  tasks        Json     @default("[]")
  // Audit trail for `tasks` above — client-built entries, same JSON-column
  // pattern as Campaign.logs (no dedicated table), so the Tasks "Team
  // activity" feed can render PMO task changes alongside the rest.
  logs         Json     @default("[]")

  // Per-tenant outbound mail (Zoho Mail SMTP) config — set by the tenant
  // owner in Settings, instead of the server-wide SMTP_* env vars. Only
  // ever populated on an owner row (mail always sends as the tenant owner's
  // mailbox); null fields fall back to the env defaults. `mailPassEnc` is
  // AES-256-GCM ciphertext (see src/utils/crypto.js), never the plaintext
  // app password.
  mailHost     String?
  mailPort     Int?
  mailUser     String?
  mailPassEnc  String?
  mailFromName String?
  mailBcc      String?

  posts          Post[]
  customers      Customer[]
  customerGroups CustomerGroup[]
  products       Product[]
  pmoProducts    Product[]       @relation("ProductPmoOwner")
  partners       Partner[]
  campaigns      Campaign[]
  assets         Asset[]
  reports        Report[]
  reportLogs     ReportLog[]
  uploadedFiles  File[]
  sales          Sale[]
  officerSales   Sale[]          @relation("SaleOfficer")
  activities     Activity[]
  assignedActs   Activity[]      @relation("ActivityAssignee")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@index([inChargeId])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

// ──────────────────────────── CRM domain ────────────────────────────
//
// Each top-level entity has `ownerId` = tenant id (the owner User's id),
// so all members of the tenant see the same data.
//
// Nested arrays (staff, tasks, taskGroups, files, productLinks, ...) are
// stored as JSONB columns to keep the API surface small and match what
// the frontend already consumes. Customer audit logs are the exception —
// they're a separate table so server-side appends are race-safe.

model Customer {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional grouping (e.g. "Strategic", "SMB", "Q4 launch")
  groupId      String?
  group        CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Core fields
  name         String
  industry     String?
  contact      String?
  email        String?
  phone        String?
  address      String?
  vatTin       String?
  stage        String   @default("Prospect")
  profileImage Json?
  pinned       Boolean  @default(false)

  // Invoice email defaults (used to pre-fill the New Invoice email section)
  billingEmail  String?
  emailCc       Json?   // optional list of default Cc addresses: ["a@x.com", ...]
  emailTemplate Json?   // optional per-customer override: { subject, body }

  // Task email settings bound to this customer (Email tab in the detail view).
  taskEmail     Json?   // { to, cc: [...], subject, body }

  // Nested collections — JSON shape mirrors StoreContext
  staff        Json     @default("[]")
  tasks        Json     @default("[]")
  taskGroups   Json     @default("[]")
  files        Json     @default("[]")
  agreements   Json     @default("[]")
  productLinks Json     @default("[]")

  logs         CustomerLog[]
  sales        Sale[]
  fromPartner  Partner?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@index([groupId])
}

model CustomerGroup {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  customers Customer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model CustomerLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  type       String
  message    String
  meta       Json?

  @@index([customerId])
  @@index([ts])
}

model Product {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // PMO assignee — distinct from `owner` above, which is the tenant owner.
  pmoOwnerId String?
  pmoOwner   User?    @relation("ProductPmoOwner", fields: [pmoOwnerId], references: [id], onDelete: SetNull)

  name       String
  type       String   @default("Service")
  price      Decimal  @default(0) @db.Decimal(14, 2)
  logo       Json?

  stage      String   @default("Intake")

  // Nested collections — JSON shape mirrors StoreContext (see Customer.staff/tasks)
  staff      Json     @default("[]")
  tasks      Json     @default("[]")

  // Activity log entries (JSON, client-appended) mirroring the customer/partner
  // audit trail — surfaced in the Tasks "Team activity" feed.
  logs       Json     @default("[]")

  lastActivityAt DateTime?

  sales      Sale[]

  income    Json     @default("[]")
  expenses  Json     @default("[]")
  assets    Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([pmoOwnerId])
}

model Partner {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  company     String?
  role        String?
  email       String?
  phone       String?
  telegram    String?
  cardImage   Json?
  telegramQr  Json?

  tasks      Json    @default("[]")
  activities Json    @default("[]")

  // A business card is a prospect until a Deal Won activity turns it into a
  // customer (PHASE-1-ACTIVITIES.md §2); then this points at that customer.
  customerId  String?   @unique
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  convertedAt DateTime?
  sales       Sale[]

  logs      PartnerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PartnerLog {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ts        DateTime @default(now())
  type      String
  message   String
  meta      Json?

  @@index([partnerId])
  @@index([ts])
}

model Campaign {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  productId   String?
  startDate   String?
  endDate     String?
  status      String   @default("Planning")

  todos       Json     @default("[]")
  // Activity log entries (JSON, client-appended) mirroring the customer/partner
  // audit trail — surfaced in the Tasks "Team activity" feed.
  logs        Json     @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model Asset {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name      String
  category  String?
  assignee  String?
  serial    String?
  status    String   @default("In use")
  photos    Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// WeBill365 usage reports. One row per account type (LM = Virtual Account,
// SM = Bank Account) per month. `data` holds each metric's figures:
//   { [metricKey]: { prevYear, currentYear, weeks: [w1,w2,w3,w4] } }
// The weekly 합계 total is derived (sum of weeks) on the client.
model Report {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  account   String   // 'LM' (Virtual Account) | 'SM' (Bank Account)
  year      Int
  month     Int
  data      Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Audit trail for report activity (create / update / delete). Tenant-scoped and
// intentionally NOT a cascade child of Report — the reportId is a soft pointer,
// so a report's history (including its deletion) survives after it is removed.
model ReportLog {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  reportId  String?  // soft pointer; kept even after the report row is gone
  actorId   String
  actorName String?
  action    String   // 'create' | 'update' | 'delete'
  account   String
  year      Int
  month     Int
  meta      Json?
  ts        DateTime @default(now())

  @@index([ownerId])
  @@index([ts])
}

// File uploads. Saved to disk under FILE_STORAGE_DIR; metadata kept here.
// `entityType`/`entityId` is a soft pointer for cleanup/auditing
// (e.g. "customer" / customer.id). The owning JSON column on the parent
// stores [{ id: file.id, description, name, ... }] for display.
model File {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy  String?

  name        String
  mimeType    String
  size        Int
  storagePath String

  entityType  String?
  entityId    String?

  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([entityType, entityId])
}

// ── Sales planner, phase 1 (PHASE-1-ACTIVITIES.md) ────────────────────────
// A Sale is one opportunity with a customer or a prospect; its Activities
// are the steps (call, meeting, demo, proposal, Deal Won …). With
// activities, the sale's status follows them: all New → New, all Done →
// Completed, else Follow-up; Cancelled is set by hand. Activity types and
// channels are fixed lists in src/utils/activities.js.

model Sale {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  saleAt      DateTime                    // date + time of the sale / first contact
  status      String    @default("New")   // New | Follow-up | Completed | Cancelled
  channel     String?
  dueDate     DateTime? @db.Date           // when the follow-up is due
  completedAt DateTime?                    // set when status becomes Completed
  notes       String?

  // The sales officer. Nullable only so deleting a sub-user keeps history.
  userId     String?
  user       User?     @relation("SaleOfficer", fields: [userId], references: [id], onDelete: SetNull)
  // Who the sale is with: a customer, or a prospect (a Partner business
  // card) — at least one is set (CHECK constraint in the migration). After a
  // prospect converts, both are set. NoAction: a customer or partner with
  // sales cannot be deleted (A5).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction)
  partnerId  String?
  partner    Partner?  @relation(fields: [partnerId], references: [id], onDelete: NoAction)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, saleAt])
  @@index([ownerId, userId, saleAt])
  @@index([ownerId, status, dueDate])
  @@index([customerId])
  @@index([partnerId])
}

// One step of a sale. Counted for the weekly KPIs by type, and shown on the
// week calendar by due date, so it is a table, not JSON (§4 rule).
model Activity {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  saleId  String
  sale    Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  type     String                     // an ACTIVITY_TYPES key, or 'Other'
  title    String?                    // details; required for 'Other'
  status   String    @default("New")  // New | In progress | Done
  dueDate  DateTime? @db.Date
  doneAt   DateTime?                  // set when status becomes Done
  position Int       @default(0)      // order within the sale

  // Person in charge — anyone on the team.
  assigneeId String?
  assignee   User?   @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId, position])
  @@index([ownerId, dueDate])
  @@index([ownerId, assigneeId, dueDate])
  @@index([ownerId, type, doneAt])
}
